# 이 파일을 .env로 복사한 뒤 키를 넣습니다. .env는 git에 올라가지 않습니다.
OPENAI_API_KEY=
TRIPO_API_KEY=

# 선택 설정 (비워 두면 기본값)
# 이미지 생성 방식: images = 이미지 모델 직접 호출(①), responses = 대화 모델 + 이미지 생성 도구(②, ChatGPT와 같은 구조)
